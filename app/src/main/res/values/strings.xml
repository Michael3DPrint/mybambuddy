    <string name="alerts_help_title">Want alerts the moment they happen?</string>
    <string name="alerts_help_intro">This app checks about every 15 minutes. Bambuddy can send alerts instantly through ntfy or Pushover.</string>
    <string name="alerts_help_step1">1. Install the ntfy app on your phone and pick a long, random topic name.</string>
    <string name="alerts_help_step2">2. In Bambuddy\'s web page, add a notification provider of type ntfy (or Pushover) with that topic.</string>
    <string name="alerts_help_step3">3. Tick the events you want, such as print finished or failed.</string>
    <string name="alerts_help_step4">4. Send the test notification, then switch off the matching alerts below so you do not get two.</string>
